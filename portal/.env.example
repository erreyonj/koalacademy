# Supabase project (publishable browser credentials — never put a secret /
# service-role key in this file; those live only in Supabase Edge Function
# secrets and are not used by the portal build).
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxx

# Cloudflare Turnstile site key (publishable). Required when Supabase CAPTCHA
# protection is enabled for anonymous sign-ins. The matching secret is set in
# Supabase (dashboard or supabase/.env as SUPABASE_AUTH_CAPTCHA_SECRET), not here.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=0x4AAAAAAEzH4EaG49DArnDm
