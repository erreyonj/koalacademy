4:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to content"}],["$","header",null,{"className":"site-header","children":["$","div",null,{"className":"site-header-inner","children":[["$","$Le",null,{"className":"site-brand","href":"/","children":[["$","img",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"","width":32,"height":32}],["$","span",null,{"children":[["$","span",null,{"className":"brand-k","children":"K"}],"oalacademy Portal"]}]]}],["$","nav",null,{"className":"band-nav","aria-label":"Grade bands","children":[[["$","$Le","k-2",{"href":"/grades/k-2/","aria-current":"$undefined","children":"K–2"}],["$","$Le","3-5",{"href":"/grades/3-5/","aria-current":"$undefined","children":"3–5"}],["$","$Le","6-8",{"href":"/grades/6-8/","aria-current":"page","children":"6–8"}]],["$","a",null,{"className":"site-link-external","href":"https://koalacademy-web.netlify.app/","target":"_blank","rel":"noopener noreferrer","children":"Site"}]]}]]}]}],["$","header",null,{"className":"page-hero","children":["$","div",null,{"className":"page-hero-inner","children":[["$","p",null,{"className":"eyebrow","children":["BMT.1"," · ","Grades 6–8"]}],["$","h1",null,{"className":"page-title","children":"Notes, Scales, and Intervals"}],["$","p",null,{"className":"page-lede","children":"Establish the shared vocabulary of Western music — natural notes, major and minor scales, intervals, and key signatures — that the rest of the course depends on."}]]}]}],["$","main",null,{"id":"main","className":"section","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"deck-screen","children":["$","span",null,{"className":"lcd","children":"Unit 1 · Basic Music Theory"}]}],["$","article",null,{"className":"slide-body","children":[["$","h2",null,{"children":"The seven natural notes"}],"\n",["$","p",null,{"children":["Western music is built on seven natural notes: ",["$","strong",null,{"children":"A, B, C, D, E, F, and G"}],". Arrange them in a specific pattern of whole steps and half steps and you have a scale. That pattern is the shared vocabulary the rest of this course depends on — sample matching, drum design, and the original project at the end of the year all come back to it."]}],"\n",["$","p",null,{"children":["The pattern for a ",["$","strong",null,{"children":"major scale"}]," is:"]}],"\n",["$","p",null,{"children":["$","strong",null,{"children":"whole, whole, half, whole, whole, whole, half"}]}],"\n",["$","p",null,{"children":"C major is the simplest case: C, D, E, F, G, A, B. Those are the white keys on a piano. A lot of songs live here because there are no sharps or flats to keep track of yet."}],"\n",["$","p",null,{"children":["The pattern for a ",["$","strong",null,{"children":"natural minor scale"}]," is:"]}],"\n",["$","p",null,{"children":["$","strong",null,{"children":"whole, half, whole, whole, half, whole, whole"}]}],"\n",["$","p",null,{"children":"A minor is C major's relative: A, B, C, D, E, F, G. Same notes, different starting place, different mood. Major tends to sound bright. Minor tends to sound heavier. You will hear that difference long before you can name the scale."}],"\n",["$","h2",null,{"children":"Why C major first"}],"\n",["$","p",null,{"children":"Western music is often taught around C major because it is the simplest map. Learn the intervals of C major — the distances between those seven notes — and every other key is the same pattern shifted. The rest of Unit 1 (modes, relative keys, the staff) is that pattern seen from a new angle."}],"\n",["$","$Lf",null,{"id":"Gs069dndIYk","title":"September","artist":"Earth, Wind & Fire"}],"\n",["$","p",null,{"children":"Bright, major-key feel. Listen for how the harmony sits \"up\" — that is the major mood you are training your ear to name."}],"\n",["$","$Lf",null,{"id":"YuKfiH0Scao","title":"Ain’t No Sunshine","artist":"Bill Withers"}],"\n",["$","p",null,{"children":"Heavier, minor-key feel. Same job, opposite mood. The question is not \"do I like this\" — it is \"what in the notes is making it feel this way?\""}],"\n",["$","$L10",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"The koala waits while you argue about whether September is actually happy.","caption":"Mood check"}],"\n","$L11","\n","$L12","\n","$L13"]}],"$L14","$L15"]}]}],"$L16"]
11:["$","h2",null,{"children":"What you should be able to do after this"}]
12:["$","ol",null,{"children":["\n",["$","li",null,{"children":"Name the seven natural notes."}],"\n",["$","li",null,{"children":"Sing or pick out the whole/half-step pattern of a major scale, starting on C."}],"\n",["$","li",null,{"children":"Hear the difference between a major and a minor example and say which is which."}],"\n",["$","li",null,{"children":"Point at a keyboard diagram and show where C major lives."}],"\n"]}]
13:["$","section",null,{"className":"do-block","children":[["$","p",null,{"className":"eyebrow","children":["Do · ","Keyboard map"]}],[["$","p",null,{"children":"On a keyboard diagram (or the classroom piano), find C. Walk the C major scale out loud: whole, whole, half, whole, whole, whole, half. Then start on A and walk A minor. Same notes — different home."}],["$","p",null,{"children":"If a game or informal check shows someone cannot place those notes yet, that is a written corrective, not a new lecture. Paper follows doing."}]]]}]
