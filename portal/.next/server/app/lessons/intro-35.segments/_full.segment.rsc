4:[["$","a",null,{"className":"skip-link","href":"#main","children":"Skip to content"}],["$","header",null,{"className":"site-header","children":["$","div",null,{"className":"site-header-inner","children":[["$","$Le",null,{"className":"site-brand","href":"/","children":[["$","img",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"","width":32,"height":32}],["$","span",null,{"children":[["$","span",null,{"className":"brand-k","children":"K"}],"oalacademy Portal"]}]]}],["$","nav",null,{"className":"band-nav","aria-label":"Grade bands","children":[[["$","$Le","k-2",{"href":"/grades/k-2/","aria-current":"$undefined","children":"K–2"}],["$","$Le","3-5",{"href":"/grades/3-5/","aria-current":"page","children":"3–5"}],["$","$Le","6-8",{"href":"/grades/6-8/","aria-current":"$undefined","children":"6–8"}]],["$","a",null,{"className":"site-link-external","href":"https://koalacademy-web.netlify.app/","target":"_blank","rel":"noopener noreferrer","children":"Site"}]]}]]}]}],["$","header",null,{"className":"page-hero","children":["$","div",null,{"className":"page-hero-inner","children":[["$","p",null,{"className":"eyebrow","children":["INTRO-35"," · ","Grades 3–5"]}],["$","h1",null,{"className":"page-title","children":"Welcome to Music Class"}],["$","p",null,{"className":"page-lede","children":"Meet Mr. Erreyon, learn what this year is for, and practice how we show up as a CREW."}]]}]}],["$","main",null,{"id":"main","className":"section","children":["$","div",null,{"className":"wrap","children":[["$","div",null,{"className":"deck-screen","children":["$","span",null,{"className":"lcd","children":"Course Introduction"}]}],["$","article",null,{"className":"slide-body","children":[["$","h2",null,{"children":"Meet Mr. Erreyon"}],"\n",["$","p",null,{"children":["My name is ",["$","strong",null,{"children":"Erreyon Elders"}],". You can call me ",["$","strong",null,{"children":"Mr. Erreyon"}]," or ",["$","strong",null,{"children":"Mr. E"}],"."]}],"\n",["$","p",null,{"children":"I am a musician and a software engineer. Most of what we will learn this year, I wrote myself."}],"\n",["$","p",null,{"children":["I grew up in ",["$","strong",null,{"children":"Chicago"}]," and graduated from Columbia College Chicago."]}],"\n",["$","p",null,{"children":["I am a dad to ",["$","strong",null,{"children":"Phoenix"}]," and a husband to ",["$","strong",null,{"children":"Kiana Elders"}]," — I met her at school. They are my besties."]}],"\n",["$","p",null,{"children":["I love a lot of music: Pop, Hip-Hop, R&B, Jazz and Jazz-Fusion, EDM and House, Footwork, Soul, Gospel, and CCM. I have not really gotten into K-Pop yet, but we ",["$","strong",null,{"children":"will"}]," talk about it this year."]}],"\n",["$","p",null,{"children":["My main instrument is ",["$","strong",null,{"children":"guitar"}],". I also play a little piano, and I produce most of the music I make these days from my phone."]}],"\n",["$","p",null,{"children":["I am a big fan of pop culture and anime. I am writing a story called ",["$","strong",null,{"children":"Swashbuckler"}]," that I hope gets illustrated one day."]}],"\n",["$","$Lf",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"The koala is ready for introductions.","caption":"Mr. E, in the building"}],"\n",["$","h2",null,{"children":"What is Koalacademy?"}],"\n",["$","p",null,{"children":["Koalacademy is this music class — and it is a bridge. We learn how music ",["$","strong",null,{"children":"works"}]," (beat, pitch, form, notation) ",["$","em",null,{"children":"and"}]," we start talking about how people ",["$","strong",null,{"children":"make"}]," music now."]}],"\n",["$","p",null,{"children":"We will have real conversations about what it takes to be called a musician or an artist. People disagree about that. That is the point."}],"\n",["$","p",null,{"children":["The goal of this course is not that we all have the same opinion. The goal is that ",["$","strong",null,{"children":"you"}]," feel confident you can:"]}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Understand the music you love"}],"\n",["$","li",null,{"children":"Bring a musical idea to life with your voice, body, and (later) notation"}],"\n",["$","li",null,{"children":"Talk about music at a high level for your grade"}],"\n"]}],"\n",["$","h2",null,{"children":"What is music — and where is it right now?"}],"\n",["$","p",null,{"children":"Some of the names and titles we will look at this year:"}],"\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17","\n","$L18","\n","$L19","\n","$L1a","\n","$L1b","\n","$L1c","\n","$L1d","\n","$L1e","\n","$L1f","\n","$L20","\n","$L21","\n","$L22","\n","$L23","\n","$L24","\n","$L25","\n","$L26","\n","$L27","\n","$L28","\n","$L29","\n","$L2a","\n","$L2b"]}],"$L2c","$L2d"]}]}],"$L2e"]
10:["$","p",null,{"children":[["$","strong",null,{"children":"Timbaland, Snoh Aalegra, Aaliyah, Jordan G. Welch, Vanessa Carlton, Kanye West, BLACKPINK, Tori Kelly, Rihanna, Bruno Mars, Snarky Puppy, Missy Elliott, Zedd, Disclosure, D'Angelo, Billie Eilish"}]," — and more."]}]
11:["$","p",null,{"children":["You will also have a way to ",["$","strong",null,{"children":"request music"}]," you want in class. Bring names. We will use them."]}]
12:["$","p",null,{"children":"To talk about those songs well, we have to agree on two things:"}]
13:["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Not everyone starts in the same place."}]," Some of you already know what a scale is. Some of you have never seen a music staff. We have to reach common ground so the discussion is fair."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Most of the music most people in the USA hear is called Popular Music."}]," Think: the songs you cannot stop hearing. Who decides what is popular, and why? What about the artists who go against that? How does \"what is popular\" change the choices artists make? Why do some people stick to a Pop sound — and how and why do others push against it?"]}],"\n"]}]
14:["$","$Lf",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"The koala is thinking about what counts as popular.","caption":"Who decided that was a hit?"}]
15:["$","h2",null,{"children":"Your year — goals and Vanguard Songs"}]
16:["$","p",null,{"children":"By the end of this year, you should be able to:"}]
17:["$","table",null,{"children":[["$","thead",null,{"children":["$","tr",null,{"children":[["$","th",null,{"children":"Goal"}],["$","th",null,{"children":"By the end of the year you can…"}]]}]}],["$","tbody",null,{"children":[["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Make"}]}],["$","td",null,{"children":"Compose a short pattern with the class and perform it."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Play together"}]}],["$","td",null,{"children":"Keep a beat without watching your neighbor. Clap simple 4/4 rhythms."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Play together"}]}],["$","td",null,{"children":"Hear major vs. minor mood, and hear when a song changes section."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Listen"}]}],["$","td",null,{"children":"Name drum sounds by ear (kick, snare, hat) and describe tone."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Listen"}]}],["$","td",null,{"children":"Keep a Vanguard Song journal — sentences, not just one word."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Respond"}]}],["$","td",null,{"children":"Read and write a simple one-line rhythm."}]]}],["$","tr",null,{"children":[["$","td",null,{"children":["$","strong",null,{"children":"Connect"}]}],["$","td",null,{"children":["Ask ",["$","em",null,{"children":"why"}]," a song feels the way it does, and give shine to classmates who try."]}]]}]]}]]}]
18:["$","h3",null,{"children":"What is a Vanguard Song?"}]
19:["$","p",null,{"children":["A ",["$","strong",null,{"children":"Vanguard Song"}]," is a song our class keeps all year. We do not listen once and move on. We come back to it again and again, and every time we know more music, we hear more inside it."]}]
1a:["$","p",null,{"children":"Your Vanguard Song(s) this year are still being locked. Mr. Erreyon will post them when they are ready. Until then, treat every listen like practice for the real thing."}]
1b:["$","p",null,{"children":"Questions we will ask (you do not have to answer them all at once):"}]
1c:["$","ul",null,{"children":["\n",["$","li",null,{"children":"Where is the steady beat? Can you keep it with your body?"}],"\n",["$","li",null,{"children":"What sounds do you hear? Can you name three?"}],"\n",["$","li",null,{"children":"When does the song change to a new part? How did you know?"}],"\n",["$","li",null,{"children":["How does this song feel? What in the ",["$","em",null,{"children":"music"}]," makes it feel that way?"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"The big one, asked in fall and again in spring:"}]," What do you hear now that you didn't hear before?"]}],"\n"]}]
1d:["$","h2",null,{"children":"How we show up — CREW and CRISP"}]
1e:["$","p",null,{"children":["We do class in a ",["$","strong",null,{"children":"circle"}],". That is CREW."]}]
1f:["$","p",null,{"children":"A circle means everyone can be seen and heard. No front row. No back row. Shared leadership. When something is hard, we talk it through in the circle instead of letting it sit."}]
20:["$","p",null,{"children":"Community commitments — our moral code — point at three jobs:"}]
21:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Improve ",["$","strong",null,{"children":"yourself"}]]}],"\n",["$","li",null,{"children":["Improve your ",["$","strong",null,{"children":"relationships"}]]}],"\n",["$","li",null,{"children":["Improve your ",["$","strong",null,{"children":"community"}]]}],"\n"]}]
22:["$","p",null,{"children":"In this class:"}]
23:["$","ul",null,{"children":["\n",["$","li",null,{"children":["I deserve respect, and you all deserve respect (that is the ",["$","strong",null,{"children":"S"}]," in CRISP)"]}],"\n",["$","li",null,{"children":"We value communication"}],"\n",["$","li",null,{"children":["I use many ",["$","strong",null,{"children":"ASL signs and signals"}]," — we will get familiar"]}],"\n",["$","li",null,{"children":["We give ",["$","strong",null,{"children":"shine and praise"}]," often"]}],"\n",["$","li",null,{"children":["We try and fail ",["$","em",null,{"children":"before"}]," we give up, complain, or self-doubt"]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Transitions are KEY."}]," Clean transitions give you the most free time and set everyone up to succeed"]}],"\n"]}]
24:["$","h3",null,{"children":"CRISP habits of character"}]
25:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Compassion"}]," — I commit to showing love, kindness, respect, and understanding to others."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Risk"}]," — I commit to trying new and challenging things, even when it is hard."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Integrity"}]," — I commit to doing the right thing, even when no one is looking."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Self-Respect"}]," — I commit to showing myself love, patience, kindness, and honesty."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Persistence"}]," — I commit to showing patience and never giving up, even when things are hard."]}],"\n"]}]
26:["$","h3",null,{"children":"How a lesson runs"}]
27:["$","p",null,{"children":["Almost everything is taught ",["$","strong",null,{"children":"I do / We do / You do"}],". Mr. Erreyon shows it. We try it together. Then you run it."]}]
28:["$","p",null,{"children":["When the room drifts, we use an attention getter — usually ",["$","strong",null,{"children":"\"If you can hear me, clap ___\""}],". We do not talk over a half-attentive room. We run the routine again."]}]
29:["$","p",null,{"children":["A lot of talk time uses ",["$","strong",null,{"children":"SAY SOMETHING"}],": read or hear an idea, then turn and talk to a partner before we share out."]}]
2a:["$","$Lf",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"The koala is waiting for you to turn and talk.","caption":"Turn and talk"}]
2b:["$","section",null,{"className":"do-block","children":[["$","p",null,{"className":"eyebrow","children":["Do · ","SAY SOMETHING"]}],[["$","p",null,{"children":"Partner up. Thirty seconds each."}],["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","em",null,{"children":"I do:"}]," Mr. Erreyon models both answers out loud — one song he loves, and one way he will show ",["$","strong",null,{"children":"Self-Respect"}]," in music class this year (patience with himself when a rhythm is hard, honesty when he does not know yet)."]}],"\n",["$","li",null,{"children":[["$","em",null,{"children":"We do:"}]," The class generates two or three example answers together so nobody is stuck."]}],"\n",["$","li",null,{"children":[["$","em",null,{"children":"You do:"}]," Each partner shares:","\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"One song you love (or want us to hear)"}],"\n",["$","li",null,{"children":["One way you will show ",["$","strong",null,{"children":"Self-Respect"}]," in this room"]}],"\n"]}],"\n"]}],"\n"]}],["$","p",null,{"children":"Then two or three pairs shine out to the circle. Write request names on the board. Those songs are now in the mix."}]]]}]
