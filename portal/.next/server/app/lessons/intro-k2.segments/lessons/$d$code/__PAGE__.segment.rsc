10:["$","p",null,{"children":"In a circle, everyone can see. Everyone can hear. Everyone gets a turn."}]
11:["$","p",null,{"children":"In this class:"}]
12:["$","ul",null,{"children":["\n",["$","li",null,{"children":["Mr. E deserves respect. ",["$","strong",null,{"children":"You"}]," deserve respect."]}],"\n",["$","li",null,{"children":"We talk. We listen."}],"\n",["$","li",null,{"children":["Mr. E uses ",["$","strong",null,{"children":"ASL signs"}]," with his hands. We will learn them together."]}],"\n",["$","li",null,{"children":["We give ",["$","strong",null,{"children":"shine"}]," — we praise each other a lot."]}],"\n",["$","li",null,{"children":"We try. We mess up. Then we try again. We do not quit first. We do not complain first. We do not say \"I can't\" first."}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Transitions are the key."}]," Fast, quiet moves from one thing to the next give you the most free time — and they help the whole class win."]}],"\n"]}]
