n":["I make music. I write songs. I play ",["$","strong",null,{"children":"guitar"}],". I play a little piano too. A lot of the music I make now, I make on my phone."]}],"\n",["$","p",null,{"children":["I grew up in ",["$","strong",null,{"children":"Chicago"}],". I went to school at Columbia College Chicago."]}],"\n",["$","p",null,{"children":["I am a dad. My kid is ",["$","strong",null,{"children":"Phoenix"}],". I am a husband. My wife is ",["$","strong",null,{"children":"Kiana"}],". I met her at school. They are my besties."]}],"\n",["$","p",null,{"children":"I love lots of music. Pop. Hip-Hop. R&B. Jazz. House. Soul. Gospel. We will hear a lot of that this year."}],"\n",["$","p",null,{"children":["I also love stories, cartoons, and anime. I am writing a story called ",["$","strong",null,{"children":"Swashbuckler"}],". I hope it gets pictures one day."]}],"\n",["$","$L3",null,{"src":"/assets/ka-main-smile-decal-no-bg.png","alt":"The koala is ready to meet the class.","caption":"Hi, I'm Mr. E"}],"\n",["$","h2",null,{"children":"What is Koalacademy?"}],"\n",["$","p",null,{"children":["This is music class. We ",["$","strong",null,{"children":"play"}],". We ",["$","strong",null,{"children":"listen"}],". We ",["$","strong",null,{"children":"learn"}],"."]}],"\n",["$","p",null,{"children":"Some of you already know songs. Some of you are just starting. That is okay. We learn together."}],"\n",["$","p",null,{"children":"This year you will:"}],"\n",["$","ul",null,{"children":["\n",["$","li",null,{"children":"Keep a beat with your body"}],"\n",["$","li",null,{"children":"Hear high and low"}],"\n",["$","li",null,{"children":"Name sounds you like"}],"\n",["$","li",null,{"children":"Talk about music you love"}],"\n"]}],"\n",["$","p",null,{"children":["The big goal: you feel like ",["$","strong",null,{"children":"you"}]," can do music."]}],"\n",["$","h2",null,{"children":"What is music?"}],"\n",["$","p",null,{"children":"Music is sound with a plan. A beat. A tune. A feeling."}],"\n",["$","p",null,{"children":"Here are some names we will hear this year:"}],"\n",["$","p",null,{"children":[["$","strong",null,{"children":"Bruno Mars. Billie Eilish. BLACKPINK. Vanessa Carlton. Missy Elliott."}]," And more."]}],"\n",["$","p",null,{"children":["Do not worry. You can tell Mr. E a song ",["$","strong",null,{"children":"you"}]," love. We will try to bring it in."]}],"\n",["$","p",null,{"children":"Two things we have to remember:"}],"\n",["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"We do not all start in the same place."}]," Some friends already know a lot. Some friends are hearing this for the first time. We help each other."]}],"\n","$L4","\n"]}],"\n","$L5","\n","$L6","\n","$L7","\n","$L8","\n","$L9","\n","$La","\n","$Lb","\n","$Lc","\n","$Ld","\n","$Le","\n","$Lf","\n","$L10","\n","$L11","\n","$L12","\n","$L13","\n","$L14","\n","$L15","\n","$L16","\n","$L17"]}],"$L18","$L19"]}]}],"$L1a"],["$L1b"],"$L1c"]}],"isPartial":"$@1d","staleTime":"$1e","varyParams":null},{"rsc":"$L1f","isPartial":"$@20","staleTime":"$1e","varyParams":null},{"rsc":"$L21","isPartial":"$@22","staleTime":"$1e","varyParams":"$23"},{"rsc":"$L24","isPartial":"$@25","staleTime":"$1e","varyParams":"$23"},{"rsc":"$L26","isPartial":"$@27","staleTime":"$1e","varyParams":null}],"isUpgradeableISRFallback":false,"a":"$@28","rootVaryParams":null,"needsRuntimeRequest":"$@29"}
