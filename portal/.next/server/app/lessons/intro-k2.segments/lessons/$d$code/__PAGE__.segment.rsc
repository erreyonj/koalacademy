14:["$","p",null,{"children":"We practice five habits. Say them with me."}]
15:["$","ul",null,{"children":["\n",["$","li",null,{"children":[["$","strong",null,{"children":"Compassion"}]," — I am kind."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Risk"}]," — I try new things, even when it is hard."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Integrity"}]," — I do the right thing, even when no one is looking."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Self-Respect"}]," — I am kind to myself."]}],"\n",["$","li",null,{"children":[["$","strong",null,{"children":"Persistence"}]," — I do not give up."]}],"\n"]}]
