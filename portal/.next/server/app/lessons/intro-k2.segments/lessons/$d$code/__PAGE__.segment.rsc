9:["$","h3",null,{"children":"Our Vanguard Song"}]
a:["$","p",null,{"children":["A ",["$","strong",null,{"children":"Vanguard Song"}]," is a song our class keeps all year."]}]
b:["$","p",null,{"children":"We do not hear it once and forget it. We come back again and again. Every time we know more music, we hear more inside it."}]
c:["$","p",null,{"children":"Our song is still being picked. Mr. E will write it on the board when it is ready."}]
d:["$","p",null,{"children":["The big question, in fall and again in spring: ",["$","strong",null,{"children":"What do you hear now that you did not hear before?"}]]}]
