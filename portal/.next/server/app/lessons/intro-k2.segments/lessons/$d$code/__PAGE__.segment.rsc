17:["$","section",null,{"className":"do-block","children":[["$","p",null,{"className":"eyebrow","children":["Do · ","If you can hear me"]}],[["$","p",null,{"children":"This is how Mr. E gets the room back. We learn it like a game."}],["$","ol",null,{"children":["\n",["$","li",null,{"children":[["$","em",null,{"children":"I do:"}]," Mr. E says, \"If you can hear me, clap once,\" and claps once. Then twice. Then a little rhythm."]}],"\n",["$","li",null,{"children":[["$","em",null,{"children":"We do:"}]," The class claps with Mr. E. Same number. Same rhythm. Then freeze."]}],"\n",["$","li",null,{"children":[["$","em",null,{"children":"You do:"}]," Mr. E calls. You answer. If the room is not with him, we try again. We do not talk over a noisy room."]}],"\n"]}],["$","p",null,{"children":["Then pick ",["$","strong",null,{"children":"one"}]," CRISP word. Mr. E says the word. The class says the kid version back:"]}],["$","ul",null,{"children":["\n",["$","li",null,{"children":"Compassion — \"I am kind.\""}],"\n",["$","li",null,{"children":"Risk — \"I try new things.\""}],"\n",["$","li",null,{"children":"Integrity — \"I do the right thing.\""}],"\n",["$","li",null,{"children":"Self-Respect — \"I am kind to myself.\""}],"\n",["$","li",null,{"children":"Persistence — \"I do not give up.\""}],"\n"]}],["$","p",null,{"children":"The class wins the round when the clap comes back together and the words come back together."}]]]}]
